# n16chat production settings. Copy to ~/n16chat/.env on the droplet,
# `chmod 600`, and fill in. Never commit the real file (.gitignore covers .env).
# Read by n16chat-backend and n16chat-worker via `env_file` in
# docker-compose.prod.yml. Unknown keys are ignored by the app (Settings has
# extra="ignore"), so a key can be added here before the code that reads it.

# ── Application ─────────────────────────────────────────────────────────────
ENVIRONMENT=production
# Never true in production (FastAPI debug tracebacks).
DEBUG=false
# Level for the app's own loggers only (third-party libraries stay at WARNING).
LOG_LEVEL=INFO
# Reported by /api/v1/health; leave unset to use the code defaults.
# APP_NAME=n16chat API
# VERSION=0.1.0

# ── Database (DO managed cluster <managed-cluster>, see docs/deploy.md) ─
# User/DB `n16chat`, the cluster's PRIVATE host, port 25060, sslmode=require.
# Percent-encode the password if it contains URL-special characters
# (@ : / ? # [ ] % &), e.g. with:
#   python3 -c 'import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=""))' '<password>'
# Each process keeps pool_size=2 + max_overflow=2 (backend 2 workers + worker 1).
DATABASE_URL=postgresql://n16chat:CHANGE_ME@<managed-postgres-host>:25060/n16chat?sslmode=require

# ── DO Spaces (attachments) ─────────────────────────────────────────────────
# Private bucket; access key limited to the `n16chat` bucket. Without KEY and
# SECRET the app still starts but uploads/file links answer 503.
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=n16chat
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_REGION=nyc3
# Host presigned URLs are signed for; only set it when the browser reaches the
# store through a different host than the backend (local MinIO). Leave unset.
# DO_SPACES_PUBLIC_ENDPOINT=
# Upload size limit (MB; the edge allows 200) and presigned URL lifetime
# (seconds, capped at 600). Defaults shown.
# ATTACHMENT_MAX_MB=25
# ATTACHMENT_URL_TTL_SECONDS=300

# WhatsApp export imports (Ajustes → Importar WhatsApp): chunk size per upload
# request (MB, clamped to 5–64), total zip limit (MB) and per-media-file limit
# the worker reads from the zip (MB). Defaults shown; none is required.
# WHATSAPP_CHUNK_MB=8
# WHATSAPP_IMPORT_MAX_MB=8192
# WHATSAPP_MEDIA_MAX_MB=200

# WhatsApp Web sync extension (docs/extension-api.md): comma-separated CORS
# origins, each exactly chrome-extension://<32-letter extension id> (from
# chrome://extensions). Empty (default) = no CORS middleware. Never allows
# credentials: the extension authenticates with its own bearer token.
# EXTENSION_ORIGINS=

# ── Auth: magic links and sessions ──────────────────────────────────────────
# Public origin of the app; magic links are <APP_BASE_URL>/acceso#token=...
APP_BASE_URL=https://app.example.com
# Session cookie is Secure outside development/test; leave unset in prod.
# SESSION_COOKIE_SECURE=true

# ── Email (Resend over SMTP) ────────────────────────────────────────────────
# Without RESEND_API_KEY production sends no magic links (a warning is
# logged) and nobody can sign in. Create a "sending access" API key for the
# app.example.com domain in Resend once the domain is verified.
RESEND_API_KEY=
EMAIL_FROM=n16chat <acceso@app.example.com>
# Defaults target Resend's SMTPS relay; override only to switch providers.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend

# ── Claude API ──────────────────────────────────────────────────────────────
# Used by the one-time bitácora importer (docs/import.md), the worker's lab
# PDF extraction (lab_extract jobs, queued after each WhatsApp import), the
# media classification (classify_media jobs), the daily analysis
# (analyze_import jobs) and the family chat. Without the key the importer refuses to extract (it can still
# load a staging file with --from-staging), lab extraction jobs fail and the
# chat answers 503. Model ids default to the ones shown.
ANTHROPIC_API_KEY=
# EXTRACTION_MODEL=claude-opus-5-5
# Images and PDFs of `daily`/`backfill` WhatsApp imports are first classified
# (classify_media jobs: lab report / prescription / medical document / other,
# one call per file content) with this cheap vision model; only lab reports
# then go to EXTRACTION_MODEL. `labs_only` PDFs skip the classifier.
# CLASSIFICATION_MODEL=claude-haiku-5-5
# Chat (tool use over the data, streamed), the cheap model that titles a new
# chat from its first exchange, and the cap on tool rounds per answer (1–20).
# CHAT_MODEL=claude-sonnet-5-5
# CHAT_TITLE_MODEL=claude-haiku-5-5
# CHAT_MAX_TOOL_ITERATIONS=8
# Daily analysis of `daily` WhatsApp imports (analyze_import jobs): new
# messages, grouped by day, become suggestions in «Pendientes». At most
# ANALYSIS_MAX_DAYS_PER_JOB days per job; the rest continue in another job.
# ANALYSIS_MODEL=claude-opus-5-5
# ANALYSIS_MAX_DAYS_PER_JOB=14
# Backfill analysis runs (admin, Importar WhatsApp → «Análisis histórico»;
# docs/import.md): default cost limit per run in USD (the run stops when its
# API cost reaches it; resume with a higher one) and the longest date range.
# BACKFILL_MAX_COST_USD=20
# BACKFILL_MAX_RANGE_DAYS=366
# Largest lab PDF sent to Claude, in MB (PDF input caps a request at 32 MB and
# base64 adds a third: never above ~23; the default keeps the 256 MB worker
# comfortable).
# LAB_PDF_MAX_MB=15
# Lab portal links shared in the chat: comma-separated host globs (e.g.
# resultados.labprueba.example,*.lab.example) the worker may download the PDF
# from (https only, public IPs only, ≤ LAB_PDF_MAX_MB). Empty: links are only
# listed under «Enlaces pendientes» for someone to open by hand.
# LAB_LINK_HOSTS=

# ── Voice-note transcription (OpenAI) ───────────────────────────────────────
# The worker transcribes WhatsApp voice notes of `daily`/`backfill` imports
# (transcribe_audio jobs; DESIGN §6.7). Audio goes to OpenAI (DESIGN §8).
# Without the key those jobs fail with a generic message (nothing recorded, so
# they can be re-queued once it is set); imports still succeed. Files over
# TRANSCRIPTION_MAX_MB (OpenAI's limit: 25) are skipped for good.
OPENAI_API_KEY=
# TRANSCRIPTION_PROVIDER=openai
# TRANSCRIPTION_MODEL=gpt-transcribe
# TRANSCRIPTION_MAX_MB=25

# Later tickets add their keys here. Each PR that needs one names it.
