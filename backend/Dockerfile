# Local development image (docker-compose.yml, scripts/run-tests.sh).
# Production image: docker/backend/Dockerfile.prod.
FROM python:3.12-slim

WORKDIR /app

# Pango/HarfBuzz + DejaVu fonts: WeasyPrint (same as Dockerfile.prod).
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz-subset0 \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
