# Production image: ghcr.io/wanderindev/n16chat-backend
# Built by .github/workflows/deploy.yml with the repo root as context.
# The same image runs the API (default CMD) and the worker
# (`python -m app.worker`, see docker-compose.prod.yml).
FROM python:3.12-slim

# Links the GHCR package to this repo (so the workflow's GITHUB_TOKEN can
# manage it and it inherits the repo's private visibility).
LABEL org.opencontainers.image.source="https://github.com/wanderindev/n16chat"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# WeasyPrint (printable PDFs, app/services/pdf/) loads Pango + HarfBuzz at
# runtime and needs a font with Spanish glyphs and ½ ¼ ¾: DejaVu Sans.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz-subset0 \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# psycopg2-binary and uvicorn[standard] ship wheels for 3.12: no compiler or
# libpq-dev needed (the dev image keeps them for convenience).
COPY backend/requirements.txt .
RUN pip install -r requirements.txt

COPY backend/ .

RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=4)" || exit 1

# 2 workers x DB pool (2 + 2 overflow) stays inside the shared cluster's
# connection budget (docs/deploy.md). --forwarded-allow-ips "*" lets uvicorn
# take scheme/host from the edge nginx (pic-frontend), but its client IP is the
# LEFTMOST X-Forwarded-For entry, which the browser can forge. Code that needs
# the real client IP (auth rate limits) reads X-Real-IP instead, which the edge
# overwrites with $remote_addr (app/api/deps.py `client_ip`).
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--proxy-headers", "--forwarded-allow-ips", "*"]
